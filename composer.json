{
    "name": "vendor/laravel-locale-json-merger",
    "description": "Compare and merge Laravel locale JSON files using English as the master locale.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "locale",
        "json",
        "translation",
        "i18n",
        "merge"
    ],
    "authors": [
        {
            "name": "Vendor",
            "email": "vendor@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Vendor\\LocaleJsonMerger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vendor\\LocaleJsonMerger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vendor\\LocaleJsonMerger\\LocaleJsonMergerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
